/**
 * 历史记录列表页样式。
 *
 * 每条记录是一张可点击卡片，删除按钮放在卡片右下角：
 * 不做侧滑也不做长按菜单——那两种交互在小程序里都需要额外的组件或手势库，
 * 而这里一个 catchtap 就够了（catch 阻止冒泡，不会误触发整卡的打开详情）。
 */

.history {
  padding-bottom: 32rpx;
  min-height: 100vh;
}

/* ---------- 筛选 Tab ---------- */

.tabs {
  display: flex;
  padding: 20rpx 24rpx 4rpx;
}

.tab {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-surface);
}

.tab-active {
  color: var(--color-surface);
  background: var(--color-primary);
  font-weight: 600;
}

/* ---------- 记录卡片 ---------- */

.record {
  padding: 26rpx 28rpx 20rpx;
}

.record-head {
  display: flex;
  align-items: center;
}

.biz-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
}

/* JD 匹配用另一组颜色，列表中扫一眼就能分辨两类记录 */
.biz-tag.biz-jdMatch {
  background: var(--color-success-subtle);
  color: var(--color-success);
}

.status {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.status-done {
  color: var(--color-success);
}

.status-failed,
.status-blocked,
.status-aborted {
  color: var(--color-warning);
}

.time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 摘要最多两行，超出省略：卡片高度稳定，列表滚动时不会跳动 */
.preview {
  display: -webkit-box;
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--color-text);
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.preview-empty {
  color: var(--color-text-tertiary);
}

.record-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.score {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.count {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.delete {
  margin-left: auto;
  padding: 6rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-quaternary);
}

/* ---------- 三态与底部 ---------- */

.center {
  text-align: center;
}

.state-icon {
  display: block;
  font-size: 64rpx;
  margin: 24rpx 0;
}

.placeholder,
.err-msg {
  display: block;
  color: var(--color-text-tertiary);
  font-size: 27rpx;
  line-height: 1.6;
  padding: 40rpx 0;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.empty-desc {
  display: block;
  margin: 16rpx 40rpx 36rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

.empty-btn,
.retry-btn {
  width: 320rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

.foot {
  padding: 32rpx 0 48rpx;
  text-align: center;
}

.foot-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
