.page {
  padding-bottom: 60rpx;
}

/* 总进度 */
.progress-card {
  margin-bottom: 24rpx;
}

.progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.progress-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  font-family: monospace;
}

.bar-track {
  height: 20rpx;
  margin-top: 16rpx;
  border-radius: 10rpx;
  background: var(--color-bg-page);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-gradient-end));
  transition: width 0.4s var(--ease-out);
}

.progress-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.progress-hint {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.reset-btn {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 4rpx 8rpx;
}

/* 阶段卡片 */
.stage-card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin: 0 var(--space-page) 24rpx;
  box-shadow: var(--shadow-card);
}

.stage-head {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.stage-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.stage-info {
  flex: 1;
  min-width: 0;
}

.stage-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.stage-bar-track {
  height: 10rpx;
  margin-top: 8rpx;
  border-radius: 5rpx;
  background: var(--color-bg-page);
  overflow: hidden;
}

.stage-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: var(--color-primary);
  transition: width 0.4s var(--ease-out);
}

.stage-num {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-left: 16rpx;
  font-family: monospace;
}

/* 检查项 */
.check-item {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.check-item:last-child {
  border-bottom: none;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--color-border-strong);
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-surface);
  box-sizing: border-box;
}

.box-on {
  background: var(--color-success);
  border-color: var(--color-success);
}

.check-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.check-on .check-text {
  color: var(--color-text-tertiary);
  text-decoration: line-through;
}
