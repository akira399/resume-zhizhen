.page {
  padding-bottom: 60rpx;
}

/* 统计 */
.stats-grid {
  display: flex;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-primary);
  font-family: monospace;
  line-height: 1.2;
}

.stat-wrong {
  color: var(--color-error);
}

.stat-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 选择 */
.mode-row,
.count-row {
  display: flex;
  margin-top: 16rpx;
  gap: 16rpx;
}

.mode-chip,
.count-chip {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.mode-on,
.count-on {
  background: var(--color-primary);
  color: var(--color-surface);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx var(--shadow-cta);
}

.start-btn {
  margin-top: 28rpx;
}

/* 刷题 */
.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quiz-progress {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-family: monospace;
}

.quiz-mode-label {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-chip);
  background: var(--color-primary-subtle);
}

.quiz-question {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.6;
}

/* 作答区 */
.answer-area {
  width: 100%;
  height: 220rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text);
}

.compare-btn {
  margin-top: 20rpx;
}

.mine-box {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--color-success-subtle);
  border-left: 6rpx solid var(--color-success);
}

.mine-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-success);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mine-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text);
  white-space: pre-wrap;
}

.mark-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.answer-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  border-left: 6rpx solid var(--color-primary);
}

.answer-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.answer-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}

.mark-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.btn-ok,
.btn-no {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-surface);
  padding: 0;
  margin: 0;
}

.btn-ok {
  background: var(--color-success);
}

.btn-no {
  background: var(--color-error);
}

.btn-ok::after,
.btn-no::after {
  border: none;
}

.show-btn {
  margin-top: 28rpx;
}

/* 完成 */
.done-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx var(--space-card);
}

.done-icon {
  font-size: 96rpx;
}

.done-title {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.done-stats {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.done-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
  text-align: center;
}

.done-btn {
  margin-top: 40rpx;
  width: 320rpx;
}
