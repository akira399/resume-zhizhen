.page {
  padding-bottom: 60rpx;
}

/* 校招倒计时 */
.recruit-card {
  border: 1rpx solid var(--color-primary-border);
  background: var(--color-primary-subtle);
}

.recruit-text {
  font-size: 28rpx;
  color: var(--color-primary-dark);
  line-height: 1.6;
}

/* 总览 */
.stats-row {
  display: flex;
  margin: 24rpx 24rpx 0;
}

.stat-item {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 28rpx 0;
  text-align: center;
  margin-right: 20rpx;
  box-shadow: var(--shadow-card);
}

.stat-item:last-child {
  margin-right: 0;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 状态分布条 */
.bar-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.bar-row:first-child {
  border-top: none;
}

.bar-label {
  flex: none;
  width: 130rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.bar-track {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--color-border);
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-gradient-end));
}

.bar-num {
  flex: none;
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-left: 16rpx;
}

.bar-pct {
  flex: none;
  width: 70rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 卡片标题行 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card-hint {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 投递趋势柱状图（CSS） */
.trend {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
  margin-top: 20rpx;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 32rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, var(--color-primary), var(--color-primary-gradient-end));
}

.trend-count {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.trend-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 漏斗 */
.funnel-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.funnel-row:first-child {
  border-top: none;
}

.funnel-label {
  flex: none;
  width: 110rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.funnel-track {
  flex: 1;
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--color-border);
  overflow: hidden;
}

.funnel-bar {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-gradient-end));
}

.funnel-num {
  flex: none;
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-left: 16rpx;
}

.funnel-pct {
  flex: none;
  width: 70rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 渠道效果 */
.channel-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.channel-row:first-child {
  border-top: none;
}

.channel-name {
  flex: 1;
  font-size: 27rpx;
  color: var(--color-text);
}

.channel-total,
.channel-offer {
  flex: none;
  width: 110rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.channel-rate {
  flex: none;
  width: 90rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 空态 */
.empty-card {
  margin-top: 24rpx;
}

.empty-icon {
  display: block;
  text-align: center;
  font-size: 64rpx;
}

.empty-title {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.empty-desc {
  display: block;
  text-align: center;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.empty-card .btn-primary {
  width: 320rpx;
  margin: 24rpx auto 0;
}

/* M10：投递时间线入口 */
.tl-entry {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}

.tl-entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(79, 110, 247, 0.12), rgba(102, 120, 255, 0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tl-entry-body {
  flex: 1;
  min-width: 0;
}

.tl-entry-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.tl-entry-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.tl-entry-arrow {
  font-size: 40rpx;
  color: var(--color-text-tertiary);
  margin-left: 12rpx;
}
