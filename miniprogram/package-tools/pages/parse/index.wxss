.page {
  padding-bottom: 60rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sample-link,
.copy-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-chip);
  background: var(--color-primary-subtle);
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.import-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-chip);
  background: var(--color-primary-subtle);
  font-weight: 600;
}

.import-btn-disabled {
  opacity: 0.6;
}

.import-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

.input-area {
  width: 100%;
  height: 240rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text);
}

.gen-btn {
  margin-top: 24rpx;
}

/* 联系方式 */
.kv-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  word-break: break-all;
}

/* 教育 */
.edu-line {
  display: block;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
  border-bottom: 1rpx solid var(--color-border);
}

.edu-line:last-child {
  border-bottom: none;
}

/* 技能 */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.skill-chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-chip);
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 24rpx;
}

/* 经历 */
.exp-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.exp-block:last-child {
  border-bottom: none;
}

.exp-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.exp-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.miss-hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-text-tertiary);
}
