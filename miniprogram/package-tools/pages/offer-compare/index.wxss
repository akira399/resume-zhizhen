.page {
  padding-bottom: 60rpx;
}

/* 权重说明 */
.dims-card {
  margin-bottom: 24rpx;
}

.dim-bar-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.dim-name {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.dim-track {
  flex: 1;
  height: 28rpx;
  border-radius: 14rpx;
  background: var(--color-bg-page);
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 14rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-dark));
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 10rpx;
  box-sizing: border-box;
}

.dim-fill-label {
  font-size: 18rpx;
  color: var(--color-surface);
  font-weight: 600;
}

/* Offer 卡片 */
.offer-card {
  margin-bottom: 24rpx;
}

.offer-head {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 8rpx;
}

.offer-rank {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.offer-rank.rank-first {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
  box-shadow: 0 6rpx 16rpx var(--color-gold-shadow);
}

.rank-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.1;
}

.rank-first .rank-num {
  color: var(--color-surface);
}

.rank-label {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
}

.rank-first .rank-label {
  color: rgba(255, 255, 255, 0.9);
}

.offer-info {
  flex: 1;
  min-width: 0;
}

.offer-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.offer-company {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.offer-total {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  font-family: monospace;
}

.offer-total.total-empty {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-tertiary);
  font-family: inherit;
}

.offer-position {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 维度滑块 */
.dim-slider-row {
  margin-top: 6rpx;
}

.slider-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.slider-label {
  font-size: 24rpx;
  color: var(--color-text);
}

.slider-weight {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.slider-line {
  display: flex;
  align-items: center;
}

.dim-slider {
  flex: 1;
  margin: 0 12rpx 0 0;
}

.slider-score {
  width: 48rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  font-family: monospace;
}

/* 完成动作 */
.action-card {
  margin-top: 8rpx;
}

.action-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-text-tertiary);
}

.empty-btn {
  margin-top: 40rpx;
  width: 320rpx;
}
