.page {
  padding-bottom: 60rpx;
}

.desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--color-text-tertiary);
}

.warn {
  color: var(--color-error);
}

.action-btn {
  margin-top: 24rpx;
}

/* 备份预览 */
.backup-preview {
  margin-top: 24rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--color-bg-page);
}

.preview-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.preview-clear {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.preview-body {
  height: 320rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.preview-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  word-break: break-all;
}

/* 导入输入 */
.import-input {
  width: 100%;
  height: 260rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text);
}
