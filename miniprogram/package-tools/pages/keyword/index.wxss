.page {
  padding-bottom: 60rpx;
}

/* ---------- 岗位方向 ---------- */

.dir-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.dir-chip {
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.dir-chip-active {
  background: var(--color-primary-subtle);
  border-color: var(--color-primary-border);
  color: var(--color-primary);
  font-weight: 600;
}

/* ---------- 简历导入 ---------- */

.section-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.import-btn {
  padding: 10rpx 24rpx;
  border-radius: var(--radius-chip);
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.import-btn-disabled {
  opacity: 0.6;
}

.import-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

/* ---------- 输入区 ---------- */

.kw-input {
  width: 100%;
  height: 200rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-bg-page);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text);
}

.sample-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.sample-tip {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-right: 12rpx;
}

.sample-chip {
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 24rpx;
}

/* ---------- 结果区 ---------- */

.result-card {
  margin-top: 32rpx;
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.result-label {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.result-score {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.result-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--color-text-tertiary);
}

.result-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--color-text);
}

.result-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 关键词标签（含已覆盖 / 缺失两态） */
.keywords {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.keyword {
  padding: 8rpx 22rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 24rpx;
  background: var(--color-success-subtle);
  color: var(--color-success);
  font-size: 24rpx;
}

.keyword-missing {
  background: var(--color-warning-subtle);
  color: var(--color-warning);
}

/* 建议列表 */
.notes {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
  padding-top: 16rpx;
}

.note-line {
  display: flex;
  padding: 8rpx 0;
}

.note-index {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  line-height: 40rpx;
}

.note-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ---------- 操作区 ---------- */

.actions {
  margin: 40rpx 24rpx 0;
}

.action-btn {
  margin-bottom: 20rpx;
}
