<view class="page">
  <view class="hero-mini">
    <view class="hero-mini-deco hero-mini-deco-a" />
    <view class="hero-mini-deco hero-mini-deco-b" />
    <text class="hero-mini-title">岗位比对</text>
    <text class="hero-mini-sub">把你的简历和岗位描述放一起，看关键词缺在哪</text>
  </view>

  <!-- 岗位方向 -->
  <view class="card">
    <text class="section-title">岗位方向</text>
    <view class="dir-row">
      <text
        wx:for="{{directions}}"
        wx:key="key"
        class="dir-chip {{direction === item.key ? 'dir-chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onDirection"
      >{{item.label}}</text>
    </view>
  </view>

  <!-- 简历 -->
  <view class="card">
    <view class="section-head-row">
      <text class="section-title">你的简历</text>
      <view class="import-btn {{importing ? 'import-btn-disabled' : ''}}" bindtap="onImportResume">
        {{importing ? '解析中…' : '📎 从文件导入'}}
      </view>
    </view>
    <textarea
      class="kw-input"
      value="{{resumeText}}"
      placeholder="粘贴简历正文…"
      maxlength="5000"
      bindinput="onResumeInput"
    />
    <view class="import-hint">支持 PDF / Word(.docx) / TXT。文件需先发到「文件传输助手」再导入。</view>
    <view class="sample-row">
      <text class="sample-tip">没有简历？用示例试试：</text>
      <text
        wx:for="{{samples}}"
        wx:key="key"
        class="sample-chip"
        data-key="{{item.key}}"
        bindtap="onUseSampleResume"
      >{{item.label}}</text>
    </view>
  </view>

  <!-- JD -->
  <view class="card">
    <text class="section-title">岗位描述（JD）</text>
    <textarea
      class="kw-input"
      value="{{jdText}}"
      placeholder="粘贴目标岗位的 JD…"
      maxlength="5000"
      bindinput="onJdInput"
    />
    <view class="sample-row">
      <text class="sample-tip">已预填示例 JD</text>
      <text class="sample-chip" bindtap="onUseSampleJd">恢复示例 JD</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary action-btn" bindtap="onCompare">开始比对</button>
  </view>

  <!-- 结果区 -->
  <block wx:if="{{hasResult}}">
    <view id="resultArea" class="card result-card">
      <view class="result-head">
        <text class="result-label">关键词覆盖率</text>
        <text class="result-score">{{result.coverage}}<text class="result-unit">%</text></text>
      </view>
      <text class="result-summary">{{result.summary}}</text>
      <text class="result-meta">JD 共识别 {{result.total}} 个要求词 · {{result.directionLabel}}</text>
    </view>

    <view wx:if="{{result.coveredKeywords.length > 0}}" class="card">
      <text class="card-title">已覆盖（{{result.coveredKeywords.length}}）</text>
      <view class="keywords">
        <text wx:for="{{result.coveredKeywords}}" wx:key="*this" class="keyword">{{item}}</text>
      </view>
    </view>

    <view wx:if="{{result.missingKeywords.length > 0}}" class="card">
      <text class="card-title">缺失（{{result.missingKeywords.length}}）</text>
      <view class="keywords">
        <text wx:for="{{result.missingKeywords}}" wx:key="*this" class="keyword keyword-missing">{{item}}</text>
      </view>
      <view class="notes">
        <view wx:for="{{result.notes}}" wx:key="*this" class="note-line">
          <text class="note-index">{{index + 1}}</text>
          <text class="note-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="btn-primary action-btn" bindtap="onSave">保存比对记录</button>
      <button class="btn-ghost action-btn" bindtap="onReset">重新填写</button>
    </view>
  </block>
</view>
