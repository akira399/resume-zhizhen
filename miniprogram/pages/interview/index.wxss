.page {
  padding-bottom: 40rpx;
}

/* 功能入口卡片（与首页 feature 一致的视觉语言） */
.entry {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(79, 110, 247, 0.12), rgba(102, 120, 255, 0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.entry-icon-review {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.14), rgba(245, 158, 11, 0.05));
}

.entry-icon-mode {
  background: linear-gradient(135deg, rgba(15, 157, 88, 0.14), rgba(15, 157, 88, 0.05));
}

.entry-body {
  flex: 1;
  min-width: 0;
}

.entry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.entry-arrow {
  font-size: 40rpx;
  color: var(--color-text-quaternary);
  margin-left: 12rpx;
  flex-shrink: 0;
}
