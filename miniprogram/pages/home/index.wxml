<view class="home">
  <!--
    上次启动异常：非阻断横幅。
    记录会持久化，一次瞬时崩溃若把首页完全挡住，用户可能长期进不了应用。
    保留为顶部横幅 + 手动关闭。
  -->
  <view wx:if="{{bootError}}" class="boot-banner">
    <text class="boot-banner-title">上次启动异常（不影响本次使用）</text>
    <text class="boot-banner-msg">{{bootError}}</text>
    <view class="boot-banner-actions">
      <button class="btn-mini" bindtap="copyError">复制错误信息</button>
      <button class="btn-mini" bindtap="dismissError">知道了</button>
    </view>
  </view>

  <!-- 品牌渐变 Hero：首页的视觉锚点 -->
  <view class="hero">
    <view class="hero-deco hero-deco-a"></view>
    <view class="hero-deco hero-deco-b"></view>
    <text class="hero-title">简历智诊</text>
    <text class="hero-sub">管好每一次投递，不错过每一次机会</text>
    <!-- 校招节点倒计时：本地日历知识 -->
    <text wx:if="{{recruitText}}" class="hero-recruit">{{recruitText}}</text>
    <button class="hero-cta" bindtap="goKanbanCta">管理投递进度</button>
  </view>

  <view class="section-head">
    <text class="section-title">工具箱</text>
  </view>

  <!-- 简历自查（M1）：规则清单，非 AI 生成 -->
  <view class="card feature" hover-class="press" bindtap="goChecklist">
    <view class="feature-icon">📋</view>
    <view class="feature-body">
      <view class="feature-head">
        <text class="feature-name">简历自查</text>
        <text class="feature-arrow">›</text>
      </view>
      <text class="feature-desc">5 大维度 24 项检查，逐项对照打分</text>
    </view>
  </view>

  <!-- 岗位比对（M2）：本地词库匹配 -->
  <view class="card feature" hover-class="press" bindtap="goKeyword">
    <view class="feature-icon feature-icon-jd">🎯</view>
    <view class="feature-body">
      <view class="feature-head">
        <text class="feature-name">岗位比对</text>
        <text class="feature-arrow">›</text>
      </view>
      <text class="feature-desc">简历 vs JD 关键词覆盖率，缺什么一目了然</text>
    </view>
  </view>

  <!-- 面试题库：本地数据，面试前速查 -->
  <view class="card feature" hover-class="press" bindtap="goQuestions">
    <view class="feature-icon feature-icon-qbank">📚</view>
    <view class="feature-body">
      <view class="feature-head">
        <text class="feature-name">面试题库</text>
        <text class="feature-arrow">›</text>
      </view>
      <text class="feature-desc">100+ 道高频题速查：行为面 / 后端 / 前端 / 算法 / HR</text>
    </view>
  </view>

  <!-- 次级入口：Tab 页的快捷直达 -->
  <view class="quick-row">
    <view class="card quick" hover-class="press" bindtap="goInterview">
      <text class="quick-icon">💬</text>
      <text class="quick-name">面试准备</text>
      <text class="quick-desc">题库 + 练习</text>
    </view>
    <view class="card quick" hover-class="press" bindtap="goKanban">
      <text class="quick-icon">📊</text>
      <text class="quick-name">求职看板</text>
      <text class="quick-desc">投递进度管理</text>
    </view>
  </view>

  <view class="quick-row">
    <view class="card quick" hover-class="press" bindtap="goStats">
      <text class="quick-icon">📈</text>
      <text class="quick-name">数据统计</text>
      <text class="quick-desc">校招倒计时 + 趋势漏斗</text>
    </view>
    <view class="card quick" hover-class="press" bindtap="goOfferCompare">
      <text class="quick-icon">⚖️</text>
      <text class="quick-name">Offer 对比</text>
      <text class="quick-desc">多维度加权打分排名</text>
    </view>
  </view>

  <view class="quick-row">
    <view class="card quick" hover-class="press" bindtap="goTodo">
      <text class="quick-icon">✅</text>
      <text class="quick-name">待办清单</text>
      <text class="quick-desc">下一步行动 + 截止日</text>
    </view>
    <view class="card quick" hover-class="press" bindtap="goTimeline">
      <text class="quick-icon">🗓️</text>
      <text class="quick-name">投递时间线</text>
      <text class="quick-desc">周/月节奏 + 目标完成度</text>
    </view>
  </view>

  <view class="quick-row">
    <view class="card quick" hover-class="press" bindtap="goCareer">
      <text class="quick-icon">🧭</text>
      <text class="quick-name">求职 Checklist</text>
      <text class="quick-desc">秋招 5 阶段 24 项清单</text>
    </view>
    <view class="card quick" hover-class="press" bindtap="goIntro">
      <text class="quick-icon">🎤</text>
      <text class="quick-name">自我介绍</text>
      <text class="quick-desc">填空生成 1/3 分钟版本</text>
    </view>
  </view>

  <view class="quick-row">
    <view class="card quick" hover-class="press" bindtap="goParse">
      <text class="quick-icon">🔍</text>
      <text class="quick-name">简历解析</text>
      <text class="quick-desc">一键提取联系方式/技能/经历</text>
    </view>
    <view class="card quick" hover-class="press" bindtap="goLearning">
      <text class="quick-icon">🧗</text>
      <text class="quick-name">学习路径</text>
      <text class="quick-desc">按岗位准备路线打勾</text>
    </view>
  </view>

  <!-- 隐私协议：未同意前拦截功能入口（提审硬要求） -->
  <view wx:if="{{privacyBlocked}}" class="privacy-mask" catchtouchmove="noop">
    <view class="privacy-dialog">
      <text class="privacy-title">用户隐私保护提示</text>
      <text class="privacy-body">
        感谢你使用「简历智诊」。在使用前，请阅读并同意{{privacyContractName}}。
      </text>
      <text class="privacy-list">
        · 我们只收集你主动填写的求职记录与简历文本，用于记录与检查，且仅你本人可见。
        · 不会收集你的手机号、通讯录、位置等无关信息。
        · 你可以随时在「我的」中删除全部数据。
      </text>

      <button
        class="btn-primary"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacy"
      >
        同意并继续
      </button>
      <button class="btn-link" bindtap="onViewPrivacy">查看完整指引</button>
    </view>
  </view>
</view>
