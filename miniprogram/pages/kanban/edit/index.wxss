/* 投递记录编辑页 */
.edit-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.form-card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  animation: card-in var(--duration-base) var(--ease-out) backwards;
}

/* 第二张表单卡错开入场，与全局 stagger 节奏一致 */
.form-card + .form-card {
  animation-delay: 60ms;
}

/* 加载失败错误卡（P2-1） */
.load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 28rpx;
}

.load-err-icon {
  font-size: 56rpx;
}

.load-err-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.retry-btn {
  margin-top: 8rpx;
  width: 320rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: 28rpx;
  padding: 0;
}

.retry-btn::after {
  border: none;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.field:last-child {
  border-bottom: none;
}

.field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 14rpx;
}

.field-row .label {
  margin-bottom: 0;
}

.req {
  color: var(--color-error);
}

.input {
  font-size: 30rpx;
  color: var(--color-text);
  height: 56rpx;
  line-height: 56rpx;
}

.textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  min-height: 100rpx;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg-page);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
}

.hints {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hint-chip {
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-subtle);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* ---- 操作 ---- */
.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary,
.btn-danger {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-surface);
}

.btn-danger {
  background: var(--color-surface);
  color: var(--color-error);
  border: 1rpx solid var(--color-error-border);
}

.btn-primary::after,
.btn-danger::after {
  border: none;
}
